        bins max_subnorm    = {8'h03};
        bins min_norm       = {8'h04};
        bins pos1           = {8'h3C};
        bins neg1           = {8'hBC};
        bins onePulp        = {8'h3D};
        bins max_finite     = {8'h7B};
        bins neg_max_finite = {8'hFB};
        bins posinfinity    = {8'h7C};
        bins neginfinity    = {8'hFC};
        bins sNaN           = {8'h7D};
        bins qNaN           = {8'h7E};
        bins negNaN         = {8'hFF};
    }

    cp_custom_ofp8_edges_widen_e5m2_cross : cross std_vec, cp_custom_ofp8_edges_widen_e5m2;

//// end cp_custom_ofp8_edges_widen ////////////////////////////////////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_emul2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_emul2 : coverpoint ins.get_vr_reg(ins.current.vd) iff (ins.trap == 0) {
        // VD register assignment (widening instruction, excluding odd registers)
        ignore_bins v1 = {v1};
        ignore_bins v3 = {v3};
        ignore_bins v5 = {v5};
        ignore_bins v7 = {v7};
        ignore_bins v9 = {v9};
        ignore_bins v11 = {v11};
        ignore_bins v13 = {v13};
        ignore_bins v15 = {v15};
        ignore_bins v17 = {v17};
        ignore_bins v19 = {v19};
        ignore_bins v21 = {v21};
        ignore_bins v23 = {v23};
        ignore_bins v25 = {v25};
        ignore_bins v27 = {v27};
        ignore_bins v29 = {v29};
        ignore_bins v31 = {v31};
    }

    //// end cp_vd_emul2////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_sew8_lmul4max
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_lmul4max_sew8_lmul_le_4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 0) {
        // Value of VTYPE.vlmul (vector register grouping), SEW = 8, excluding LMUL = 8
        `ifdef LMULf8_SUPPORTED
            bins eighth  = {5};
        `endif
        `ifdef LMULf4_SUPPORTED
            bins fourth = {6};
        `endif
        `ifdef LMULf2_SUPPORTED
            bins half   = {7};
        `endif
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_lmul4max_sew8 : cross cp_csr_vtype_lmul_all_lmul4max_sew8_lmul_le_4,cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 0)  {
        // Cross coverage all legal LMULs (excluding LMUL = 8) for SEW = 8 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_lmul4max_sew8////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_lmul4max
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vta")[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
    }

    cp_csr_vtype_vma : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vma")[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
    }

    mask_enabled_agnostic: coverpoint ins.current.insn[25] {
        bins enabled = {1'b0};
    }

    cr_vtype_agnostic_lmul4max : cross cp_csr_vtype_vta,cp_csr_vtype_vma,mask_enabled_agnostic iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

    //// end cr_vtype_agnostic_lmul4max////////////////////////////////////////////////

endgroup
// ---------------------
function void zvfofp8min_sample(int hart, int issue, ins_t ins);
    string inst_name = traceDataQ[hart][issue][0].inst_name;

    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 0 ||
        get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") == 1) begin
        case (inst_name)
            "vfncvt.f.f.q"     : begin
                Zvfofp8min_vfncvt_f_f_q_cg.sample(ins);
            end
            "vfncvt.sat.f.f.q"     : begin
                Zvfofp8min_vfncvt_sat_f_f_q_cg.sample(ins);
            end
            "vfncvtbf16.f.f.w"     : begin
                Zvfofp8min_vfncvtbf16_f_f_w_cg.sample(ins);
            end
            "vfncvtbf16.sat.f.f.w"     : begin
                Zvfofp8min_vfncvtbf16_sat_f_f_w_cg.sample(ins);
            end
            "vfwcvtbf16.f.f.v"     : begin
                Zvfofp8min_vfwcvtbf16_f_f_v_cg.sample(ins);
            end
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
endfunction
