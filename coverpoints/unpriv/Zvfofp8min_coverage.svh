    cp_custom_ofp8_edges_widen_e4m3 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val)[7:0]  iff (ins.trap == 0 && get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "altfmt") == 0)  {
